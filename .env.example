# Copy this file to .env and fill in your values
# Never commit .env to git

# Required
WEATHER_API_KEY=your_openweathermap_api_key_here

# MySQL (required if using MySQL backend)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=weather_db

# Optional: MongoDB for text storage
# MONGO_URI=mongodb://localhost:27017/

# Optional: use a custom SQLite path (default: weather_data.db)
# SQLITE_PATH=weather_data.db

# Optional: collector interval in seconds (default: 600 = 10 min)
# COLLECTOR_INTERVAL=600
